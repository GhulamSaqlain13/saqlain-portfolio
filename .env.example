# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Public URL only. NEVER put a Gemini API key in NEXT_PUBLIC variables.
# Leave blank for the local FAQ + project brief helper.
NEXT_PUBLIC_ASSISTANT_URL=
# Example: https://saqlain-portfolio-assistant.YOUR-SUBDOMAIN.workers.dev/chat
