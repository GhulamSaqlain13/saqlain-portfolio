{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "saqlain-portfolio-assistant",
  "main": "assistant.mjs",
  "compatibility_date": "2026-10-10",
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://ghulamsaqlain13.github.io",
  },
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "SITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
}
